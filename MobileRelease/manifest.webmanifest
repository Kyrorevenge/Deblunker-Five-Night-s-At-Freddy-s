{
  "name": "DFNAF Mobile",
  "short_name": "DFNAF",
  "description": "Deblunker Five Nights at Freddy's — mobile web preview",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#0c0c0e",
  "theme_color": "#0c0c0e",
